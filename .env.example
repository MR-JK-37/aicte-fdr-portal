# Copy to .env and fill in. Never commit the real .env.
ENV=dev
# API/worker connect as the unprivileged fdr_app role (RLS applies to it).
DATABASE_URL=postgresql+psycopg://fdr_app:fdr_app_dev_password@localhost:5432/fdr
# Alembic only: must run as the superuser/table-owner to create fdr_app,
# RLS policies and triggers. Never used by the API or worker processes.
MIGRATION_DATABASE_URL=postgresql+psycopg://fdr:fdr@localhost:5432/fdr
VALKEY_URL=redis://localhost:6379/0
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_ACCESS_KEY=devaccesskey
GARAGE_SECRET_KEY=devsecretkeydevsecretkey
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=fdr-portal

# Filled in during later phases:
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_API_TOKEN=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# SARVAM_API_KEY=
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
