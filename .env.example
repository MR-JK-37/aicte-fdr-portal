# Copy to .env and fill in. Never commit the real .env.
ENV=dev
# API/worker connect as the unprivileged fdr_app role (RLS applies to it).
DATABASE_URL=postgresql+psycopg://fdr_app:fdr_app_dev_password@localhost:5432/fdr
# Alembic only: must run as the superuser/table-owner to create fdr_app,
# RLS policies and triggers. Never used by the API or worker processes.
MIGRATION_DATABASE_URL=postgresql+psycopg://fdr:fdr@localhost:5432/fdr
# Insight (text2sql) agent only — SELECT-only on an allow-listed view set.
READONLY_DATABASE_URL=postgresql+psycopg://fdr_readonly:fdr_readonly_dev_password@localhost:5432/fdr
VALKEY_URL=redis://localhost:6379/0
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_ACCESS_KEY=devaccesskey
GARAGE_SECRET_KEY=devsecretkeydevsecretkey
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=fdr-portal
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Mailpit in dev (real SMTP, caught locally) — swap for a real relay in production.
SMTP_HOST=localhost
SMTP_PORT=1025
# Keep false until a licensed CPaaS + TRAI robocall intimation exist (see progress.md Phase 7).
PRODUCTION_TELEPHONY_ENABLED=false

# LLM gateway — Groq is the only verified provider so far (see
# config/llm_providers.yaml and progress.md Phase 6a).
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CLOUDFLARE_API_TOKEN=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# SARVAM_API_KEY=
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
