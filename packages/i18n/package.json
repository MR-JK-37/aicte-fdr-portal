{
  "name": "@aicte-fdr/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "ICU message-format catalogue + loader for apps/web and apps/mobile (MASTER_PROMPT \u00a727 / F-27). English is authoritative; Hindi and Tamil ship as machine-draft placeholders at launch.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./catalogs/*": "./catalogs/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "intl-messageformat": "^10.7.16"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}
