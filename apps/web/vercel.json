{
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter web build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://aicte-fdr-api.onrender.com/v1/:path*" },
    { "source": "/api/:path*", "destination": "https://aicte-fdr-api.onrender.com/api/:path*" }
  ]
}
