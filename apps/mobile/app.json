{
  "expo": {
    "name": "AICTE FDR Security Deposit",
    "slug": "aicte-fdr-mobile",
    "version": "1.0.0",
    "scheme": "aictefdr",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.aicte.fdr.mobile"
    },
    "android": {
      "package": "org.aicte.fdr.mobile",
      "permissions": [
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
