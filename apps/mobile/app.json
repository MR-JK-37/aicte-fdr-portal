{
  "expo": {
    "name": "AICTE FDR Security Deposit",
    "slug": "aicte-fdr-mobile",
    "version": "1.0.0",
    "scheme": "aictefdr",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.aicte.fdr.mobile"
    },
    "android": {
      "package": "org.aicte.fdr.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#050505"
      },
      "permissions": [
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "./plugins/withAndroidNetworkSecurityConfig.js"
    ]
  }
}
